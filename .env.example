# ============================================================
# Chai Partner - Environment Variables Example
# ============================================================

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=chai_partner
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chai_partner

# Redis Cache & Ephemeral State
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Server Ports & URLs
PORT=4000
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Authentication & Cryptographic Secrets
JWT_SECRET=super_secret_jwt_key_chai_partner_change_in_production_2026
QR_HMAC_SECRET=chai_partner_qr_signing_secret_min_32_characters_long
PHONE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef # 32 bytes hex for AES-256-GCM

# Payments (Razorpay)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

# OTP Provider
OTP_PROVIDER=mock # mock | msg91 | twilio
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Sentry Monitoring Placeholders
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Cafe Metadata (Dynamically configurable, not hardcoded)
CAFE_NAME="Chai Partner"
DEFAULT_TABLE_COUNT=25
SESSION_TTL_MINUTES=120
GST_PERCENT=5.0
